# Copy to .env and fill in. Never commit real values. Setup steps are in SPEC.md section 10.

# --- Model: pick ONE. The app uses the first one it finds, in this order. ---
# Not needed for trucking accounts or for opening saved runs.
# Claude (paid, prepaid credits): https://platform.claude.com -> API keys
ANTHROPIC_API_KEY=
# Google Gemini (free tier, no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Google AI Studio project that owns the Gemini key (reference only; the app does not read these)
GEMINI_PROJECT_NAME=
GEMINI_PROJECT_NUMBER=
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (has free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Local model: install Ollama (https://ollama.com/download) and pull a model; no key, detected automatically.
# Any other OpenAI-compatible endpoint (LiteLLM, LM Studio, ...):
LLM_BASE_URL=
LLM_API_KEY=
# Optional: force a specific model name for whichever provider is active.
LLM_MODEL=

# --- Asked for by the SEC on filing lookups (works without, politer with): who is calling, e.g. "Jane Doe jane@example.com" ---
SEC_USER_AGENT=

# --- Optional, free tiers ---
# Exa: much better web and people search than the keyless fallback. https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# Apollo: company facts (headcount, revenue, funding). Contact and email lookup need a paid plan. https://app.apollo.io -> Settings -> Integrations -> API
APOLLO_API_KEY=
# Direct phone numbers: Apollo sends them to a public HTTPS address a few minutes after a request.
# PUBLIC_URL is that address for this app (a tunnel or a host). Leave empty to keep the feature off.
PUBLIC_URL=
# Mobile credits Apollo charges per direct number on your plan (check Apollo -> Settings -> Credits). Shown before every request.
APOLLO_PHONE_CREDITS=8
# Firecrawl: fallback for pages the built-in fetch cannot read. https://firecrawl.dev
FIRECRAWL_API_KEY=

# --- Only for sign-in, invites and the hosted copy. Leave empty to run locally with files and no login. ---
# Supabase project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# First owner. This Google account can invite others and set their role.
OWNER_EMAIL=

# --- Optional: who people should ask when a key is missing. Shown in the app's set-up window, e.g. "Jane (jane@company.com)". ---
ADMIN_CONTACT=

# --- Sign-in, for a shared or hosted copy. Leave AUTH_ENABLED=false to open the app without signing in. ---
AUTH_ENABLED=false
# One line of JSON. role "owner" can do everything; "guest" cannot spend Apollo credits, edit positioning or delete accounts.
# "notify": true sends you a message each time that sign-in is used.
AUTH_USERS=[{"email":"you@example.com","password":"change-me","label":"Me","role":"owner","notify":false},{"email":"team@example.com","password":"change-me-too","label":"Team","role":"guest","notify":true}]
# Keeps people signed in across restarts. Any long random text.
SESSION_SECRET=
# New research runs a guest sign-in may start per day.
GUEST_DAILY_RUNS=15
# Free notifications. Slack: an "incoming webhook" URL. ntfy: any hard-to-guess topic name, then subscribe to it in the ntfy phone app.
NOTIFY_SLACK_WEBHOOK=
NOTIFY_NTFY_TOPIC=
# WhatsApp to your own number through CallMeBot (free, unofficial). Phone with country code, e.g. +351912345678.
NOTIFY_WHATSAPP_PHONE=
NOTIFY_WHATSAPP_APIKEY=
# Set to true only on a hosted copy that is meant to be reached from the internet. Sign-in must be on.
ALLOW_PUBLIC_UI=
